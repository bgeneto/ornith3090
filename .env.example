# Copy this file to .env before starting Docker Compose.
# .env is ignored by git so local keys and tuning changes stay out of commits.

# Speed-first single-user config for a local RTX 3090 with Ornith-1.5-9B.
# This is the repo's recommended default for best single-user speed.
COMPOSE_PROFILES=single
MODEL=models/Ornith-1.5-9B-MixedInt4-AutoRound
SPEC=mtp
DRAFT_TOKENS=4
PREFIX_CACHE=1

# Hugging Face Access Token for faster model downloads (avoids anonymous rate limits):
# Get one free at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional toggles kept commented out for easy activation later.
# Uncomment ONLY when you need the behaviour below.

# HF_XET_HIGH_PERFORMANCE=1
# Uses the Rust-based hf_transfer backend for multi-gigabit parallel downloads.
# Enabled by default in Docker and prepare scripts.

# DRAFT_TOKENS=4
# Number of speculative draft tokens proposed per MTP forward pass.
# Sweep between 1 and 5 (4 is typically optimal for 9B Qwen3.5/Ornith architecture).

# MTP_DRAFT_VOCAB=0
# Default is 1 (40k truncated draft head, ~0.5ms draft steps). Set 0 to draft with
# the full 248k lm_head instead (more acceptance, ~3ms per draft).

CTX=fast

# CTX=long
# Use when you need about 150k context with FP8 KV cache.
# Slower than the default speed mode (CTX=fast); good for longer chats or long prompts.

# CTX=huge
# Maximum-context profile for up to 262k context.

# On WSL2/Docker Desktop, keep enabled to allow UVA pinned memory allocation.
VLLM_WSL2_ENABLE_PIN_MEMORY=1

# GPU_UTIL=0.95
# GPU memory utilization fraction (0.95 gives plenty of headroom on 24GB for Ornith-1.5-9B).
# On 8GB (e.g. RTX 4060 Ti) under WSL2, stay at or below 0.84: vLLM refuses to start
# unless free VRAM >= GPU_UTIL * total, and the compositor already holds ~1 GiB.

# CPU_OFFLOAD_GB=2
# Set to 2 or 3 if testing on an 8GB GPU (e.g. RTX 4060 Ti) to offload embeddings to system RAM.
# Leave unset / 0 on 24GB GPUs (e.g. RTX 3090).

# SLEEP_LEVEL=0
# vLLM sleep mode. 0 or commented = disabled (no --enable-sleep-mode).
# 1 or 2 = pass --enable-sleep-mode and VLLM_SERVER_DEV_MODE=1 so /sleep and
# /wake_up work. The level is used by POST /sleep?level=N (not a serve CLI arg
# in vLLM 0.28): 1 offloads weights to CPU; 2 discards weights and KV cache.

# MAX_SEQS=8
# Concurrency limit for single-user mode.

# INT8_ACT=int8
# Enables Marlin W4A8 INT8 tensor cores on linear layers for +25-30% faster prefill.

# SPEC_ATTN=1
# Split-KV attention for multi-query MTP verification (patches/spec-decode-attn.patch).
# Enabled by default on CTX=fast.

# SERVED_MODEL_NAME=ornith-1.5-9b
# OpenAI-compatible model id advertised by vLLM (`--served-model-name`).
# Clients send this in the `model` field. Default is ornith-1.5-9b.

# VLLM_API_KEY=
# Optional for local-only use; REQUIRED before the port is reachable by anything but this
# machine, because the server has no authentication at all without it. Generate one rather
# than inventing one -- this is the step docs/docker.md used to make unavoidable:
#   Linux/WSL:  echo "VLLM_API_KEY=$(openssl rand -hex 24)" >> .env

# FAST_VARIANT=0
# Uncomment only if you want to skip the extra fast-variant download during the first boot.
# This is a lighter first-time setup and can help on constrained hosts, but it gives up the faster variant.

# PORT=18020
# Host port only. Compose publishes PORT:8000; vLLM listens on 8000 inside
# the container (vLLM's default). PORT=8002 → localhost:8002 → vLLM :8000.
# Changing this requires recreating the container, not just restart:
#   docker compose --profile single up -d --force-recreate

# NVIDIA_GPU=0
# Host GPU index (or UUID) passed to Compose device_ids. Default is 0.
# Example for the second card: NVIDIA_GPU=1
# Do not set CUDA_VISIBLE_DEVICES here: Compose remaps the chosen card to
# cuda:0 inside the container, and a host index would then miss the device.

# SPEC=dflash2
# Optional Phase 2 block drafter (requires models/Ornith-1.5-9B-DFlash2-W4A16).
# Keep SPEC=mtp until C1 benches beat k=4. LOOKUP=1 and DFLASH_TOKENS=15 for copy/quote.
# DFLASH2=1
# During `docker compose run --rm prepare`, try to fetch/install the Ornith DFlash2 dir.

# Train DFlash2 inside Compose (stop `single` first — one GPU):
#   docker compose --profile train run --rm train --smoke
# NeMo is installed into /cache/venv-dflash2, not the serving venv.

# MAX_LEN=65536
# Override only if you intentionally want a different context ceiling for the active profile.
# The defaults are chosen for the profile in [single-user/start_ornith.sh](single-user/start_ornith.sh).
