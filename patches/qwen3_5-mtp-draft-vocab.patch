+def _pad_mtp_draft_lm_head_weight(
+    name: str, weight: torch.Tensor, org_v: int, padded_v: int
+) -> torch.Tensor:
+    # GPTQ stores vocab on dim 1; vLLM's embedding weight_loader pads dim 0.
+    if org_v == padded_v or padded_v <= 0:
+        return weight
+    key = name.rsplit(".", 1)[-1]
+    if key in ("g_idx",):
+        return weight
+    if key == "weight_shape":
+        out = weight.clone()
+        out[0] = padded_v
+        return out
+    if weight.ndim == 1:
+        if weight.shape[0] == org_v:
+            return torch.nn.functional.pad(weight, (0, padded_v - org_v))
+        return weight
+    if key in ("qweight", "scales"):
+        if weight.shape[1] == org_v:
+            return torch.nn.functional.pad(weight, (0, padded_v - org_v))
+        return weight
+    if key == "qzeros":
+        pack = org_v // weight.shape[1] if weight.shape[1] else 0
+        if pack < 1 or org_v % pack or padded_v % pack:
+            return weight
+        if weight.shape[1] * pack != org_v:
+            return weight
+        tgt = padded_v // pack
+        if weight.shape[1] == tgt:
+            return weight
+        return torch.nn.functional.pad(weight, (0, tgt - weight.shape[1]))
+    if key in ("weight_packed", "weight_scale", "weight"):
+        if weight.shape[0] == org_v:
+            return torch.nn.functional.pad(weight, (0, 0, 0, padded_v - org_v))
+        return weight
+    return weight
+
 
